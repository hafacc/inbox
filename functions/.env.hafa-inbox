# Public deploy params for the hafa-inbox project; secrets go in Secret Manager, never here.
# Google OAuth Web client id (the one Firebase Auth created for Google sign-in).
GOOGLE_CLIENT_ID=477521298784-3eti5o33bkp8es32qgrfks5qppf0qt33.apps.googleusercontent.com
# KMS key that seals refresh tokens; a non-interactive deploy doesn't fall back to the code's default.
KMS_KEY=projects/hafa-inbox/locations/global/keyRings/inbox/cryptoKeys/refresh-tokens
# Cloudflare ids for @hafa.cc addresses, from https://dash.cloudflare.com/?to=/:account/hafa.cc
# (the "API" box on the right). While either is empty, claims stay pending as "not-configured".
CLOUDFLARE_ACCOUNT_ID=e29a61ebaabe95c0079b66f13a66cb8c
CLOUDFLARE_ZONE_ID=2deefac57b7eb870a64e33c7267c556d
# Workers KV namespace the Key Worker (workers/wkd) serves public keys from; the id that
# `bunx wrangler kv namespace create inbox-wkd-keys` prints. While empty, keys aren't published.
CLOUDFLARE_KV_NAMESPACE_ID=b2593ffee878428cbb1603a760f8c5db
