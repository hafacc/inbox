  "email": {
    "_doc": "Message bodies. Light: drawn as sent on white. Dark: the mail's own colors are turned (shared/src/dark-mail.ts): light backgrounds go dark and dark text goes light, keeping hue, then text is made to reach 4.5:1 on what is behind it. `dark` is the page, unset text and quote colors; unset links take the theme's `emailLink.dark`. Pictures are drawn as sent, dimmed by `dim`.",
    "dim": "brightness(0.9)",
    "light": {
      "background": "#ffffff",
      "text": "#23211d",
      "quote": "#e6e1d7"
    },
    "dark": {
      "background": "#201e1b",
      "text": "#eeeae2",
      "quote": "#4a453e"
    }
  }
