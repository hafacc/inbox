            "draftId",
            "from",
            "status",
            "sendAt",
            "chosenAt",
            "threadId"
          ]
        },
        "now": 1030001
      },
      "expect": "late"
    },
    {
      "name": "before its time by this clock it waits",
      "input": {
        "sendNow": true,
        "docs": 1,
        "online": true,
        "gmailRoute": true,
        "wroteSendAt": 1000000,
        "doc": {
          "status": "waiting",
          "sendAt": 1000000,
          "fields": [
            "draftId",
            "from",
            "status",
            "sendAt",
            "chosenAt",
            "threadId"
          ]
        },
        "now": 999999
