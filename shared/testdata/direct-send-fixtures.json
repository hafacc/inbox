        "online": true,
        "gmailRoute": true,
        "wroteSendAt": 1000000,
        "doc": {
          "status": "waiting",
          "sendAt": 1000000,
          "fields": [
            "draftId",
            "from",
            "status",
            "sendAt",
            "chosenAt",
            "threadId",
            "via",
            "draftMessageId"
          ]
        },
        "now": 1000000
