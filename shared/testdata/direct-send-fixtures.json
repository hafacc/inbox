    },
    {
      "name": "a doc without the optional fields still goes",
      "input": {
        "sendNow": true,
        "docs": 1,
        "online": true,
        "gmailRoute": true,
        "wroteSendAt": 1000000,
        "doc": {
          "status": "waiting",
          "sendAt": 1000000,
          "fields": [
            "draftId",
            "from",
            "status",
            "sendAt"
          ]
        },
        "now": 1000000
      },
      "expect": "send"
    }
  ],
  "resendDomain": "hafa.cc",
  "sendAs": [
    {
      "sendAsEmail": "ana@gmail.example.com",
      "isPrimary": true
    },
    {
      "sendAsEmail": "Ana@Work.example",
      "verificationStatus": "accepted"
    },
    {
      "sendAsEmail": "ana@pending.example",
      "verificationStatus": "pending"
    },
    {
      "sendAsEmail": "test@hafa.cc",
      "verificationStatus": "accepted"
    }
  ],
  "route": [
    {
      "name": "the Gmail address",
      "from": "ana@gmail.example.com",
      "expect": "send"
    },
    {
      "name": "case and spaces don't matter",
      "from": "  Ana@Gmail.example.com ",
      "expect": "send"
    },
    {
      "name": "a verified alias",
      "from": "ana@work.example",
      "expect": "send"
    },
    {
      "name": "an alias Gmail hasn't verified",
      "from": "ana@pending.example",
      "expect": "server"
    },
    {
      "name": "an address Gmail doesn't know",
      "from": "ana@other.example",
      "expect": "server"
    },
    {
      "name": "@hafa.cc goes through Resend even when Gmail lists it",
      "from": "test@hafa.cc",
      "expect": "server"
    }
  ],
  "sender": [
    {
      "name": "a named mailbox",
      "headers": [
        {
          "name": "From",
          "value": "Ana Lee <Ana@Gmail.example.com>"
        }
      ],
      "expect": "ana@gmail.example.com"
    },
    {
      "name": "a bare address",
      "headers": [
        {
          "name": "From",
          "value": "ana@gmail.example.com"
        }
      ],
      "expect": "ana@gmail.example.com"
    },
    {
      "name": "a quoted name with a comma and an at sign",
      "headers": [
        {
          "name": "From",
          "value": "\"Lee, Ana @ home\" <ana@gmail.example.com>"
        }
      ],
      "expect": "ana@gmail.example.com"
    },
    {
      "name": "an encoded name",
      "headers": [
        {
          "name": "From",
          "value": "=?UTF-8?Q?Ana_L=C3=A9e?= <ana@gmail.example.com>"
        }
      ],
      "expect": "ana@gmail.example.com"
    },
    {
      "name": "the header name in any case",
      "headers": [
        {
          "name": "FROM",
          "value": "ana@gmail.example.com"
        }
      ],
      "expect": "ana@gmail.example.com"
    },
    {
      "name": "no From",
      "headers": [
        {
          "name": "To",
          "value": "bob@example.com"
        }
      ],
      "expect": null
    },
    {
      "name": "two From headers",
      "headers": [
        {
          "name": "From",
          "value": "ana@gmail.example.com"
        },
        {
          "name": "From",
          "value": "ana@gmail.example.com"
        }
      ],
      "expect": null
    },
    {
      "name": "two mailboxes",
      "headers": [
        {
          "name": "From",
          "value": "ana@gmail.example.com, bob@example.com"
        }
      ],
      "expect": null
    },
    {
      "name": "a second address in the name",
      "headers": [
        {
          "name": "From",
          "value": "bob@example.com <ana@gmail.example.com>"
        }
      ],
      "expect": null
    },
    {
      "name": "a group",
      "headers": [
        {
          "name": "From",
          "value": "friends: <ana@gmail.example.com>;"
        }
      ],
      "expect": null
    },
    {
      "name": "a comment",
      "headers": [
        {
          "name": "From",
          "value": "ana@gmail.example.com (Ana)"
        }
      ],
      "expect": null
    },
    {
      "name": "an unquoted comma in the name",
      "headers": [
        {
          "name": "From",
          "value": "Lee, Ana <ana@gmail.example.com>"
        }
      ],
      "expect": null
    }
  ],
  "failure": [
    {
      "name": "no answer",
      "error": null,
      "expect": "leave"
    },
    {
      "name": "a bad request is a refusal",
      "error": {
        "status": 400,
        "reason": "invalidArgument"
      },
      "expect": "rejected"
    },
    {
      "name": "a forbidden send is a refusal",
      "error": {
        "status": 403,
        "reason": "forbidden"
      },
      "expect": "rejected"
    },
    {
      "name": "too large",
      "error": {
        "status": 413,
        "reason": null
      },
      "expect": "rejected"
    },
    {
      "name": "a 403 rate limit passes",
      "error": {
        "status": 403,
        "reason": "userRateLimitExceeded"
      },
      "expect": "leave"
    },
    {
      "name": "a 429 passes",
      "error": {
        "status": 429,
        "reason": null
      },
      "expect": "leave"
    },
    {
      "name": "an expired token passes",
      "error": {
        "status": 401,
        "reason": null
      },
      "expect": "leave"
    },
    {
      "name": "a timeout passes",
      "error": {
        "status": 408,
        "reason": "timeout"
      },
      "expect": "leave"
    },
    {
      "name": "a draft gone is the server's to look up",
      "error": {
        "status": 404,
        "reason": "notFound"
      },
      "expect": "leave"
    },
    {
      "name": "a server error passes",
      "error": {
        "status": 503,
        "reason": null
      },
      "expect": "leave"
    }
  ]
