{
  "_doc": {
    "about": "A snoozed thread's derived state, run by shared/src/thread-snooze.spec.ts and Android :core SnoozeStateTest. Times are epoch milliseconds; history ids are decimal strings compared as numbers. A doc is users/{uid}/threads/{id} as read (snoozeUntil null when cleared).",
    "status": "snoozeStatus(doc, now, hasNewerMessage): none (no doc or cleared), woken (a newer message arrived in the inbox), snoozed (snoozeUntil after now), else lapsed.",
    "sortDate": "inboxSortDate(lastDate, doc, status): the later of lastDate and snoozeUntil when lapsed, else lastDate.",
    "archivedElsewhere": "snoozeArchivedElsewhere(doc, gmailLabelIds, gmailHistoryId, now, hasLocalChange): true only for a snooze still ahead, no local change on its way, Gmail's copy out of the inbox and newer than the watermark.",
    "newerMail": "newerMail(records, watermarks): which snoozed threads a history.list scan says got newer mail, and where it arrived. Records are Gmail's, oldest first. inInbox ends the snooze; skippedInbox keeps it and shows a hint."
  },
  "status": [
    {
      "name": "no doc is not snoozed",
      "doc": null,
      "now": 1800000000000,
      "hasNewerMessage": false,
      "expect": "none"
    },
    {
      "name": "a cleared snooze is not snoozed",
      "doc": {
        "snoozeUntil": null,
        "snoozeWatermark": "5"
      },
      "now": 1800000000000,
      "hasNewerMessage": false,
      "expect": "none"
    },
    {
      "name": "a cleared snooze stays cleared when newer mail arrives",
      "doc": {
        "snoozeUntil": null,
        "snoozeWatermark": "5"
      },
      "now": 1800000000000,
      "hasNewerMessage": true,
      "expect": "none"
    },
    {
      "name": "a snooze still ahead hides the thread",
      "doc": {
        "snoozeUntil": 1800000000001,
        "snoozeWatermark": "5"
      },
      "now": 1800000000000,
      "hasNewerMessage": false,
      "expect": "snoozed"
    },
    {
      "name": "it lapses at the moment it ends, with nothing written",
      "doc": {
        "snoozeUntil": 1800000000001,
        "snoozeWatermark": "5"
      },
      "now": 1800000000001,
      "hasNewerMessage": false,
      "expect": "lapsed"
    },
    {
      "name": "newer mail wakes a snooze still ahead",
      "doc": {
        "snoozeUntil": 1800000000001,
        "snoozeWatermark": "5"
      },
      "now": 1800000000000,
      "hasNewerMessage": true,
      "expect": "woken"
    },
    {
      "name": "newer mail counts over a lapse",
      "doc": {
        "snoozeUntil": 1800000000001,
        "snoozeWatermark": "5"
      },
      "now": 1800000000001,
      "hasNewerMessage": true,
      "expect": "woken"
    }
  ],
  "sortDate": [
    {
      "name": "a lapsed thread sorts by when it came back",
      "lastDate": 1799999999000,
      "doc": {
        "snoozeUntil": 1800000000000,
        "snoozeWatermark": "1"
      },
      "status": "lapsed",
      "expect": 1800000000000
    },
    {
      "name": "a lapsed thread with mail after it came back sorts by that mail",
      "lastDate": 1800000001000,
      "doc": {
        "snoozeUntil": 1800000000000,
        "snoozeWatermark": "1"
      },
      "status": "lapsed",
      "expect": 1800000001000
    },
    {
      "name": "a woken thread sorts by its newest message",
      "lastDate": 1799999999000,
      "doc": {
        "snoozeUntil": 1800000000000,
        "snoozeWatermark": "1"
      },
      "status": "woken",
      "expect": 1799999999000
    },
    {
      "name": "a snoozed thread sorts by its newest message",
      "lastDate": 1799999999000,
      "doc": {
        "snoozeUntil": 1800000005000,
        "snoozeWatermark": "1"
      },
      "status": "snoozed",
      "expect": 1799999999000
    },
    {
      "name": "no snooze sorts by its newest message",
      "lastDate": 1799999999000,
      "doc": null,
      "status": "none",
      "expect": 1799999999000
    }
  ],
