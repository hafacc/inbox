{
  "_doc": "What a search lists (shared/src/search-scope.ts, Android :core SearchScope.kt). `scope`: searchScope(query): Gmail's query (null when Gmail lists no mail for it), whether spam and trash are asked for, which todos show (none, all, snoozed) and whether only snoozed threads show; `is:pinned` and `is:done` reach Gmail as `is:starred` and `-in:inbox`. `todos`: searchTodos(todos, query, now), the ids in order; every todo is `base` with the listed fields replaced; times are epoch milliseconds, local times read in `zone`; `labels` are the account's labels, which `label:` reads against todos' tags (labelTags). `in:inbox` keeps todos not done, `is:done` the done ones, `is:pinned`/`is:starred` the pinned ones, `is:snoozed` the snoozed ones; each negated keeps the others. `emailTodos`: searchEmailTodos(todos, query), the thread ids of the emails listed for their todo's text, in order; each todo is {threadId, text}. Whether the email is in the inbox, snoozed, pinned or done is the email's own, held to it by the list's filter, so those terms, negated or not, drop none here; a mail operator lists none.",
  "zone": "America/New_York",
  "labels": [
    {"id": "L1", "name": "Read Later", "type": "user"},
    {"id": "L2", "name": "Work/Projects", "type": "user"},
    {"id": "CATEGORY_PROMOTIONS", "name": "CATEGORY_PROMOTIONS", "type": "system"}
  ],
  "base": {"id": "a", "text": "Buy *milk* #home", "state": "ACTIVE", "createdAt": 1794400000000, "modifiedAt": 1794400000000, "snoozeUntil": null, "pinned": false, "position": null, "deleted": false, "repeat": null, "repeatSpawned": false, "occurrence": null},
  "scope": [
    { "name": "words search mail and todos", "query": "milk", "expect": { "gmailQuery": "milk", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "a mail operator leaves todos out", "query": "from:ana@example.com milk", "expect": { "gmailQuery": "from:ana@example.com milk", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "is:todo alone lists todos and no mail", "query": "is:todo", "expect": { "gmailQuery": null, "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "is:todo with words runs no Gmail search", "query": "is:todo milk", "expect": { "gmailQuery": null, "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "-is:todo alone lists all mail and no todos", "query": "-is:todo", "expect": { "gmailQuery": "", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "-is:todo with words searches mail only", "query": "-is:todo milk", "expect": { "gmailQuery": "milk", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "is:snoozed alone comes from the device's snoozes", "query": "is:snoozed", "expect": { "gmailQuery": null, "includeSpamTrash": false, "todos": "snoozed", "snoozedOnly": true } },
    { "name": "is:snoozed with words searches Gmail and keeps the snoozed", "query": "is:snoozed milk", "expect": { "gmailQuery": "milk", "includeSpamTrash": false, "todos": "snoozed", "snoozedOnly": true } },
    { "name": "is:snoozed with a mail operator leaves todos out", "query": "is:snoozed from:ana", "expect": { "gmailQuery": "from:ana", "includeSpamTrash": false, "todos": "none", "snoozedOnly": true } },
    { "name": "label: keeps todos", "query": "label:read-later", "expect": { "gmailQuery": "label:read-later", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "label: with a mail operator leaves todos out", "query": "label:read-later from:ana", "expect": { "gmailQuery": "label:read-later from:ana", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "in:inbox keeps todos", "query": "in:inbox", "expect": { "gmailQuery": "in:inbox", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "-in:inbox keeps todos", "query": "-in:inbox milk", "expect": { "gmailQuery": "-in:inbox milk", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "is:done asks Gmail for mail out of the inbox and keeps todos", "query": "is:done", "expect": { "gmailQuery": "-in:inbox", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "-is:done asks Gmail for the inbox", "query": "-is:done milk", "expect": { "gmailQuery": "in:inbox milk", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "is:pinned asks Gmail for starred mail and keeps todos", "query": "is:pinned", "expect": { "gmailQuery": "is:starred", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "is:starred keeps todos", "query": "is:starred", "expect": { "gmailQuery": "is:starred", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "-is:snoozed keeps todos", "query": "-is:snoozed milk", "expect": { "gmailQuery": "milk", "includeSpamTrash": false, "todos": "all", "snoozedOnly": false } },
    { "name": "is:snoozed in:inbox keeps the snoozed todos", "query": "is:snoozed in:inbox", "expect": { "gmailQuery": "in:inbox", "includeSpamTrash": false, "todos": "snoozed", "snoozedOnly": true } },
    { "name": "is:done with a mail operator leaves todos out", "query": "is:done from:ana", "expect": { "gmailQuery": "-in:inbox from:ana", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "is:unread leaves todos out", "query": "is:unread", "expect": { "gmailQuery": "is:unread", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "in:outbox alone lists no Gmail mail", "query": "in:outbox", "expect": { "gmailQuery": null, "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } },
    { "name": "in:spam asks for spam", "query": "in:spam lunch", "expect": { "gmailQuery": "in:spam lunch", "includeSpamTrash": true, "todos": "none", "snoozedOnly": false } },
    { "name": "-in:trash doesn't", "query": "-in:trash lunch", "expect": { "gmailQuery": "-in:trash lunch", "includeSpamTrash": false, "todos": "none", "snoozedOnly": false } }
  ],
