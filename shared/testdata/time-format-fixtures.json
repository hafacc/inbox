{
  "_doc": {
    "about": "Dates and sizes as lists, message headers and wake times show them, run by shared/src/time-format.spec.ts and Android :core TimeFormatTest (America/New_York; now and date are local wall times). Clocks are 24-hour HH:mm; month and day names are en-US. Days are calendar days, so a 23- or 25-hour day around a clock change is still one day.",
    "listDate": "formatListDate(date, now): HH:mm on now's day, \"Oct 28\" earlier this year (or later), \"Oct 28, 2025\" in another year.",
    "messageDate": "formatMessageDate(date, now): \"Today 08:47\", \"Yesterday 08:47\", \"Oct 30, 08:47\" this year, \"Oct 30, 2025, 08:47\" another year.",
    "wakeTime": "formatWakeTime(date, now): HH:mm on now's day, \"Tue 09:00\" one to six days ahead, otherwise \"Nov 19 09:00\" (no year).",
    "lapsedMarker": "lapsedMarker(date, now) for a snooze that ended at date: \"Snoozed · back at 09:00\" today, \"… back yesterday at 18:00\", \"… back Saturday at 09:00\" two to six days ago, \"… back Oct 26 at 21:15\" before that.",
    "size": "formatSize(bytes): under 1024 bytes in B; then KB rounded (half up) while that is under 1024; then MB with one decimal."
  },
