  "emails": [
    {
      "name": "retail newsletter: nested tables, bgcolor, a style block and a dark button",
      "html": "<style type=\"text/css\">\nhtml, body { margin:0 !important; background-color:#f2f2f2 !important; }\ntable, td { border-collapse:collapse; }\n.headline { font-size:28px; color:#111111; font-weight:bold; }\n.copy { color:#444444; font-size:15px; }\n.btn a { background:#1b1b1b; color:#ffffff !important; padding:14px 28px; display:inline-block; }\n.footer td { color:#8a8a8a; font-size:12px; }\n@media only screen and (max-width:600px) { .container { width:100% !important; } .copy { color:#555555 !important; } }\n</style>\n<div id=\"outer\" style=\"background-color:#f2f2f2;\">\n<table role=\"presentation\" width=\"100%\" bgcolor=\"#f2f2f2\"><tr><td align=\"center\" style=\"padding:20px 0;\">\n<table role=\"presentation\" class=\"container\" id=\"card\" width=\"600\" bgcolor=\"#ffffff\" style=\"background:#ffffff;\">\n<tr><td align=\"center\" style=\"padding:24px;\"><img src=\"data:image/png;base64,iVBORw0KGgo=\" width=\"140\" alt=\"Tailor Store\"></td></tr>\n<tr><td id=\"headline\" align=\"center\" class=\"headline\">The Winter Edit is here</td></tr>\n<tr><td id=\"copy\" align=\"center\" class=\"copy\">Tailored wool coats, merino knits and chinos.</td></tr>\n<tr><td align=\"center\" class=\"btn\"><a id=\"button\" href=\"https://example.com/shop\">SHOP NOW</a></td></tr>\n<tr><td><table width=\"100%\"><tr>\n<td id=\"tile1\" width=\"50%\" bgcolor=\"#f7f3ee\"><b id=\"tile1-name\" style=\"color:#5a3e2b\">Wool overcoat</b><br><span id=\"tile1-price\" style=\"color:#7a6a5a\">$289</span></td>\n<td id=\"tile2\" width=\"50%\" bgcolor=\"#eef3f7\"><b id=\"tile2-name\" style=\"color:#2b405a\">Merino crew</b></td>\n</tr></table></td></tr>\n<tr><td id=\"promo\" bgcolor=\"#fff4d6\" style=\"padding:12px 24px;color:#7a5b00;\" align=\"center\">Use code <strong id=\"code\">WARM20</strong> for 20% off</td></tr>\n<tr class=\"footer\"><td id=\"footer\" bgcolor=\"#e9e9e9\" align=\"center\">You are receiving this because you signed up.<br><a id=\"unsubscribe\" href=\"https://example.com/unsub\" style=\"color:#8a8a8a\">Unsubscribe</a></td></tr>\n</table></td></tr></table></div>",
