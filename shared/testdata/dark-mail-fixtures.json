      "html": "<style type=\"text/css\">\nbody,#bodyTable{background-color:#FAFAFA;}\n#templateHeader{background-color:#FFFFFF;background-image:none;}\n#templateBody{background-color:#FFFFFF;background-image:none;border-bottom:2px solid #EAEAEA;}\n#templateFooter{background-color:#FAFAFA;background-image:none;}\n#templateBody .mcnTextContent,#templateBody .mcnTextContent p{color:#202020;}\n#templateFooter .mcnTextContent{color:#656565;}\n#templateFooter .mcnTextContent a{color:#656565;}\nh1{color:#202020;}\na:hover{color:#0a0a0a;}\n</style>\n<center><table id=\"bodyTable\" width=\"100%\"><tr><td id=\"bodyCell\">\n<table width=\"100%\" style=\"max-width:600px\">\n<tr><td id=\"templateHeader\" style=\"background:#FFFFFF none no-repeat center/cover;background-color:#FFFFFF;background-image:none;\"><img src=\"data:image/png;base64,iVBORw0KGgo=\" alt=\"Logo\"></td></tr>\n<tr><td id=\"templateBody\" style=\"background:#FFFFFF none no-repeat center/cover;background-color:#FFFFFF;background-image:none;\"><div class=\"mcnTextContent\"><h1 id=\"title\">November newsletter</h1><p id=\"para\">Here's what's new this month.</p><p><a id=\"cta\" href=\"https://example.com\" style=\"background-color:#2baadf;color:#ffffff;padding:12px 20px;\">Read more</a></p></div></td></tr>\n<tr><td id=\"templateFooter\" style=\"background:#FAFAFA none no-repeat center/cover;background-color:#FAFAFA;background-image:none;\"><div class=\"mcnTextContent\"><em id=\"copyright\">Copyright © 2026 The Shop.</em><br><a id=\"unsub\" href=\"https://example.com/u\">unsubscribe from this list</a></div></td></tr>\n</table></td></tr></table></center>",
