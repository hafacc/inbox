      "text": "’a"
    },
    {
      "name": "latin1 label",
      "charset": "latin1",
      "data": "6Q",
      "text": "é"
    },
    {
      "name": "windows-1252 bytes it leaves undefined read as C1 controls",
      "charset": "windows-1252",
      "data": "gY2PkJ0",
      "text": ""
    },
    {
      "name": "iso-8859-9 reads as windows-1254",
