  ],
  "address": [
    {
      "name": "quoted name with a comma",
      "value": "\"Chen, Maya\" <Maya.Chen@Gmail.example.com>",
      "expect": [
        {
          "name": "Chen, Maya",
          "email": "maya.chen@gmail.example.com"
        }
      ]
    },
    {
      "name": "bare address",
      "value": "sam@proton.example.net",
      "expect": [
        {
          "name": "",
          "email": "sam@proton.example.net"
        }
      ]
    },
    {
      "name": "a list with a trailing comma",
      "value": "\"Chen, Maya\" <maya@x.example.com>, Dana Ortiz <dana@y.example.com>,",
      "expect": [
        {
          "name": "Chen, Maya",
          "email": "maya@x.example.com"
        },
        {
          "name": "Dana Ortiz",
          "email": "dana@y.example.com"
        }
      ]
    },
    {
      "name": "escaped quotes inside a quoted name don't end it",
      "value": "\"Maya \\\"M, C\\\" Chen\" <maya@x.example.com>, dana@y.example.com",
      "expect": [
        {
          "name": "Maya \"M, C\" Chen",
          "email": "maya@x.example.com"
        },
        {
          "name": "",
          "email": "dana@y.example.com"
        }
      ]
    },
    {
      "name": "a name folded onto two lines reads as one",
      "value": "\"Chen,\r\n Maya\" <maya@x.example.com>",
      "expect": [
        {
          "name": "Chen, Maya",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "an unquoted name across a line break",
      "value": "Maya\n  Chen <maya@x.example.com>",
      "expect": [
        {
          "name": "Maya Chen",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "a name in a comment after a bare address",
      "value": "maya@x.example.com (Maya Chen), dana@y.example.com (Ortiz, Dana)",
      "expect": [
        {
          "name": "Maya Chen",
          "email": "maya@x.example.com"
        },
        {
          "name": "Ortiz, Dana",
          "email": "dana@y.example.com"
        }
      ]
    },
    {
      "name": "a comment after an angled address isn't part of it",
      "value": "Maya Chen <maya@x.example.com> (work)",
      "expect": [
        {
          "name": "Maya Chen",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "a comma inside angle brackets",
      "value": "Odd <odd,one@x.example.com>",
      "expect": [
        {
          "name": "Odd",
          "email": "odd,one@x.example.com"
        }
      ]
    },
    {
      "name": "a group gives its members without its name",
      "value": "Team: a@x.example.com, Bo <b@x.example.com>; c@x.example.com",
      "expect": [
        {
          "name": "",
          "email": "a@x.example.com"
        },
        {
          "name": "Bo",
          "email": "b@x.example.com"
        },
        {
          "name": "",
          "email": "c@x.example.com"
        }
      ]
    },
    {
      "name": "an empty group gives no one",
      "value": "undisclosed-recipients:;",
      "expect": []
    },
    {
      "name": "a colon after an @ doesn't start a group",
      "value": "a@b\nbcc:x@y.z, c@x.example.com",
      "expect": [
        {
          "name": "",
          "email": "a@b\nbcc:x@y.z"
        },
        {
          "name": "",
          "email": "c@x.example.com"
        }
      ]
    },
    {
      "name": "angle brackets with no name",
      "value": "<Maya@X.example.com>",
      "expect": [
        {
          "name": "",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "a quoted name with no angle brackets is part of the address",
      "value": "\"maya\"@x.example.com",
      "expect": [
        {
          "name": "",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "an unclosed angle bracket runs to the end",
      "value": "Maya <maya@x.example.com",
      "expect": [
        {
          "name": "Maya",
          "email": "maya@x.example.com"
        }
      ]
    },
    {
      "name": "empty",
      "value": "",
      "expect": []
    },
    {
      "name": "only commas and spaces",
      "value": " , ,",
      "expect": []
    },
    {
      "name": "the last angle brackets hold the address",
      "value": "Maya <old@x.example.com> <maya@x.example.com>",
      "expect": [
        {
          "name": "Maya",
          "email": "maya@x.example.com"
        }
      ]
    }
  ],
  "entities": [
    {
      "name": "named and numeric",
      "value": "I&#39;ll book &amp; pay &lt;3 &#x2014; &nbsp;ok &bogus;",
      "expect": "I'll book & pay <3 —  ok &bogus;"
    },
    {
      "name": "names in any case",
      "value": "&AMP; &Quot; &APOS; &GT;",
      "expect": "& \" ' >"
    },
    {
      "name": "astral by decimal and hex",
      "value": "&#128512; &#X1F600;",
      "expect": "😀 😀"
    },
    {
      "name": "past U+10FFFF reads as U+FFFD, not an error",
      "value": "a&#99999999;b&#x110000;c&#x7FFFFFFFFFFF;d",
      "expect": "a�b�c�d"
    },
    {
      "name": "very long digits",
      "value": "&#000000000000065;&#99999999999999999999999;",
      "expect": "A�"
    },
    {
      "name": "zero and surrogates read as U+FFFD",
      "value": "&#0;&#xD800;&#57343;",
      "expect": "���"
    },
    {
      "name": "0x80–0x9F read as windows-1252",
      "value": "&#147;hi&#148; &#x80;5 &#x81;",
      "expect": "“hi” €5 "
    },
    {
      "name": "no semicolon stays as written",
      "value": "&amp &#39 &#x;",
      "expect": "&amp &#39 &#x;"
    }
  ]
}
