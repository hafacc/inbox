          },
          {
            "partId": "2",
            "mimeType": "text/calendar",
            "filename": "b.ics",
            "headers": [
              {
                "name": "Content-Type",
                "value": "text/calendar; charset=ISO-8859-1"
              }
            ],
            "body": {
              "size": 10,
              "attachmentId": "att-b"
            }
          }
