      "data": "R3LDvMOfZSDigJQgMTk6MzA",
      "text": "Grüße — 19:30"
    },
    {
      "name": "padded base64",
      "charset": "utf-8",
      "data": "YWI=",
      "text": "ab"
    },
    {
      "name": "base64url's - and _",
      "charset": "utf-8",
      "data": "w78_Pg",
      "text": "ÿ?>"
    },
    {
      "name": "iso-8859-1 reads as windows-1252, so smart quotes survive",
