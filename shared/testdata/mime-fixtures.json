      },
      "expect": {
        "html": null,
        "text": "Hi",
        "attachments": [
          {
            "partId": "1",
            "filename": "a.ics",
            "mimeType": "application/ics",
            "size": 10,
            "attachmentId": "att-a",
            "data": null
          },
          {
            "partId": "2",
            "filename": "b.ics",
            "mimeType": "text/calendar",
            "size": 10,
            "attachmentId": "att-b",
            "data": null
