      "text": "€"
    },
    {
      "name": "iso-8859-2",
      "charset": "iso-8859-2",
      "data": "seo",
      "text": "ąę"
    },
    {
      "name": "windows-1251",
      "charset": "windows-1251",
      "data": "z_Do4uXy",
      "text": "Привет"
    },
    {
      "name": "koi8-r",
      "charset": "koi8-r",
      "data": "8NLJ18XU",
      "text": "Привет"
    },
    {
      "name": "gb2312 reads as gbk",
      "charset": "gb2312",
      "data": "xOO6ww",
      "text": "你好"
    },
    {
      "name": "shift_jis",
      "charset": "shift_jis",
      "data": "grGC8YLJgr-CzQ",
      "text": "こんにちは"
    },
    {
      "name": "ks_c_5601-1987 reads as euc-kr",
      "charset": "ks_c_5601-1987",
      "data": "vsiz5w",
      "text": "안녕"
    },
    {
      "name": "big5",
      "charset": "big5",
      "data": "p0Gmbg",
      "text": "你好"
    },
    {
      "name": "utf-16 with no byte order mark is little-endian",
      "charset": "utf-16",
      "data": "SABpAA",
      "text": "Hi"
    },
    {
      "name": "utf-16be",
      "charset": "utf-16be",
      "data": "AEgAaQ",
      "text": "Hi"
    },
    {
      "name": "a utf-8 byte order mark goes",
      "charset": "utf-8",
      "data": "77u_SGk",
      "text": "Hi"
    },
    {
      "name": "a utf-16le byte order mark goes",
      "charset": "utf-16le",
      "data": "__5IAA",
      "text": "H"
    },
    {
      "name": "a bad utf-8 byte reads as one replacement character",
      "charset": "utf-8",
      "data": "Yf9i",
      "text": "a�b"
    },
    {
      "name": "unknown labels read as utf-8",
      "charset": "x-unknown-charset",
      "data": "cGxhaW4gw6k",
      "text": "plain é"
    },
    {
      "name": "labels mapped to replacement read as utf-8",
      "charset": "iso-2022-kr",
      "data": "cGxhaW4gw6k",
      "text": "plain é"
    },
    {
      "name": "labels ignore case and surrounding spaces",
      "charset": " ISO-8859-1 ",
      "data": "kw",
      "text": "“"
