  "contentType": [
    {
      "name": "quoted, any case",
      "contentType": "text/html; charset=\"ISO-8859-1\"",
      "charset": "iso-8859-1"
    },
    {
      "name": "bare, with more parameters",
      "contentType": "text/calendar; charset=UTF-8; method=REQUEST",
      "charset": "utf-8"
    },
    {
      "name": "absent",
      "contentType": "text/plain",
      "charset": "utf-8"
    },
    {
      "name": "no header",
      "contentType": null,
      "charset": "utf-8"
    }
  ],
  "body": [
    {
      "name": "the main alternative's bodies, inline parts and attachments; a forwarded message's body doesn't win",
      "payload": {
        "partId": "",
        "mimeType": "multipart/mixed",
        "parts": [
          {
            "partId": "0",
            "mimeType": "multipart/related",
            "parts": [
              {
                "partId": "0.0",
                "mimeType": "multipart/alternative",
                "parts": [
                  {
                    "partId": "0.0.0",
                    "mimeType": "text/plain",
                    "headers": [
                      {
                        "name": "Content-Type",
                        "value": "text/plain; charset=UTF-8"
                      }
                    ],
                    "body": {
                      "size": 5,
                      "data": "SGVsbG8"
                    }
                  },
                  {
                    "partId": "0.0.1",
                    "mimeType": "text/html",
                    "body": {
                      "size": 30,
                      "data": "PHA-SGVsbG8gPGltZyBzcmM9ImNpZDpsb2dvQHgiPjwvcD4"
                    }
                  }
                ]
              },
              {
                "partId": "0.1",
                "mimeType": "image/png",
                "filename": "logo.png",
                "headers": [
                  {
                    "name": "Content-ID",
                    "value": "<logo@x>"
                  },
                  {
                    "name": "Content-Disposition",
                    "value": "inline"
                  }
                ],
                "body": {
                  "size": 100,
                  "attachmentId": "att-logo"
                }
              }
            ]
          },
          {
            "partId": "1",
            "mimeType": "application/pdf",
            "filename": "Lease_2027.pdf",
            "headers": [
              {
                "name": "Content-Disposition",
                "value": "attachment; filename=\"Lease_2027.pdf\""
              }
            ],
            "body": {
              "size": 421888,
              "attachmentId": "att-pdf"
            }
          },
          {
            "partId": "2",
            "mimeType": "message/rfc822",
            "parts": [
              {
                "partId": "2.0",
                "mimeType": "text/html",
                "body": {
                  "size": 9,
                  "data": "PHA-b2xkPC9wPg"
                }
              }
            ]
          }
        ]
      },
      "expect": {
        "html": "<p>Hello <img src=\"cid:logo@x\"></p>",
        "text": "Hello",
        "attachments": [
          {
            "partId": "1",
            "filename": "Lease_2027.pdf",
            "mimeType": "application/pdf",
            "size": 421888,
            "attachmentId": "att-pdf",
            "data": null
          }
        ],
        "inline": [
          {
            "partId": "0.1",
            "contentId": "logo@x",
            "mimeType": "image/png",
            "filename": "logo.png",
            "size": 100,
            "attachmentId": "att-logo",
            "data": null
          }
        ],
        "calendar": null
      }
    },
    {
      "name": "a single-part message is its own body",
      "payload": {
        "mimeType": "text/plain",
        "body": {
          "size": 2,
          "data": "SGk"
        }
      },
      "expect": {
        "html": null,
        "text": "Hi",
        "attachments": [],
        "inline": [],
        "calendar": null
      }
    },
    {
      "name": "a body part decodes in its own charset",
      "payload": {
        "partId": "",
        "mimeType": "text/html",
        "headers": [
          {
            "name": "Content-Type",
            "value": "text/html; charset=iso-8859-1"
          }
        ],
        "body": {
          "size": 4,
          "data": "k2hplA"
        }
      },
      "expect": {
        "html": "“hi”",
        "text": null,
        "attachments": [],
        "inline": [],
        "calendar": null
      }
    },
    {
      "name": "an inline part marked as an attachment, a text part with a Content-ID, and a nameless attachment",
      "payload": {
        "partId": "",
        "mimeType": "multipart/mixed",
        "parts": [
          {
            "partId": "0",
            "mimeType": "text/html",
            "body": {
              "size": 4,
              "data": "PHAvPg"
            }
          },
          {
            "partId": "1",
            "mimeType": "image/jpeg",
            "filename": "photo.jpg",
            "headers": [
              {
                "name": "Content-ID",
                "value": "<photo@x>"
              },
              {
                "name": "Content-Disposition",
                "value": "attachment"
              }
            ],
            "body": {
              "size": 7,
              "attachmentId": "att-photo"
            }
          },
          {
            "partId": "2",
            "mimeType": "text/plain",
            "headers": [
              {
                "name": "Content-ID",
                "value": "<note@x>"
              }
            ],
            "body": {
              "size": 4,
              "data": "bm90ZQ"
            }
          },
          {
            "partId": "3",
            "mimeType": "application/octet-stream",
            "headers": [
              {
                "name": "Content-Disposition",
                "value": " ATTACHMENT"
              }
            ],
            "body": {
              "size": 3,
              "data": "YWJj"
            }
          },
          {
            "partId": "4",
            "mimeType": "image/gif",
            "headers": [
              {
                "name": "Content-ID",
                "value": "  <dot@x>  "
              }
            ],
            "body": {
              "size": 1,
              "data": "AA"
            }
          },
          {
            "partId": "5",
            "mimeType": "image/gif",
            "headers": [
              {
                "name": "Content-ID",
                "value": "<>"
              }
            ],
            "body": {
              "size": 1,
              "data": "AA"
            }
          }
        ]
      },
      "expect": {
        "html": "<p/>",
        "text": "note",
        "attachments": [
          {
            "partId": "1",
            "filename": "photo.jpg",
            "mimeType": "image/jpeg",
            "size": 7,
            "attachmentId": "att-photo",
            "data": null
          },
          {
            "partId": "3",
            "filename": "attachment",
            "mimeType": "application/octet-stream",
            "size": 3,
            "attachmentId": null,
            "data": "YWJj"
          }
        ],
        "inline": [
          {
            "partId": "4",
            "contentId": "dot@x",
            "mimeType": "image/gif",
            "filename": "",
            "size": 1,
            "attachmentId": null,
            "data": "AA"
          }
        ],
        "calendar": null
      }
    },
    {
      "name": "the bare text/calendar is the invite, over an earlier .ics file, which lists as an attachment",
      "payload": {
        "partId": "",
        "mimeType": "multipart/mixed",
        "parts": [
          {
            "partId": "0",
            "mimeType": "application/ics",
            "filename": "invite.ics",
            "headers": [
              {
                "name": "Content-Disposition",
                "value": "attachment; filename=\"invite.ics\""
              }
            ],
            "body": {
              "size": 10,
              "attachmentId": "att-ics"
            }
          },
          {
            "partId": "1",
            "mimeType": "multipart/alternative",
            "parts": [
              {
                "partId": "1.0",
                "mimeType": "text/plain",
                "body": {
                  "size": 2,
                  "data": "SGk"
                }
              },
              {
                "partId": "1.1",
                "mimeType": "text/calendar",
                "headers": [
                  {
                    "name": "Content-Type",
                    "value": "text/calendar; charset=\"UTF-8\"; method=REQUEST"
                  }
                ],
                "body": {
                  "size": 5,
                  "data": "QkVHSU4"
                }
              }
            ]
          }
        ]
      },
      "expect": {
        "html": null,
        "text": "Hi",
        "attachments": [
          {
            "partId": "0",
            "filename": "invite.ics",
            "mimeType": "application/ics",
            "size": 10,
            "attachmentId": "att-ics",
            "data": null
          }
        ],
        "inline": [],
        "calendar": {
          "partId": "1.1",
          "data": "QkVHSU4",
          "attachmentId": null,
          "charset": "utf-8"
        }
      }
    },
    {
      "name": "with no bare text/calendar, the first calendar file is the invite",
      "payload": {
        "partId": "",
        "mimeType": "multipart/mixed",
        "parts": [
          {
            "partId": "0",
            "mimeType": "text/plain",
            "body": {
              "size": 2,
              "data": "SGk"
            }
          },
          {
            "partId": "1",
