        {"kind": "paragraph", "runs": [{"text": "Hello "}, {"text": "world", "marks": ["bold"]}]},
        {"kind": "paragraph", "runs": [{"text": "second line"}]},
        {"kind": "paragraph", "runs": []},
        {"kind": "paragraph", "runs": [{"text": "New paragraph"}]}
      ],
      "html": "Hello <b>world</b><br>second line<br><br>New paragraph",
      "text": "Hello *world*\nsecond line\n\nNew paragraph"
    },
