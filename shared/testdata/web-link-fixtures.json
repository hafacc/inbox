{
  "_doc": {
    "about": "Web addresses found in plain text (a todo's text, a plain-text email body), which every client must show as links: web (shared/src/web-links.ts) and Android :core (mail/WebLinks.kt).",
    "find": "findWebLinks(text), each link as the text it covers and its href. An http(s):// URL runs to the next space, <, > or \"; a bare domain is dot-separated labels of a-z, 0-9 and inner hyphens ending in a listed top-level domain (any case), then an optional :port and an optional path starting /, ? or #. Neither starts right after a letter, digit or one of @ . - / + % = & # ~ \\; a bare domain right before a letter or digit, or before more of an email address up to its @ (letters, digits, _ . % + -), isn't one, nor one right before _ unless the _ closes a style (no letter, digit or @ after it). Trailing ?!.,:;*_~'\" and unmatched ) are left out. A bare domain's href puts https:// before it; every href is then unwrapped as in link-fixtures.json, kept only when what it unwraps to is an http, https or mailto address, and has its scheme in lower case.",
    "address": "linkAddress(typed), a link's address as typed in the composer's link dialog: trimmed, with https:// put before one without a scheme; any scheme but http, https and mailto gives null, and those are put in lower case.",
    "safe": "safeHref(href): href trimmed with its scheme in lower case when that is http, https or mailto, else null (no scheme, javascript:, data:, a scheme split by a space or control character).",
    "finished": "finishedWebLink(before), the address the composer links once a space or line break is typed after `before`: the last link findWebLinks finds, when only non-space characters follow it and no unclosed backtick comes before it; href as written, https:// put before a bare domain, not unwrapped.",
    "styled": "Links in a todo's text are styledTree's link nodes; see the styled cases of todo-list-fixtures.json."
  },
  "find": [
    { "name": "https URL", "text": "read https://example.com/a?b=1#c now", "links": [{ "text": "https://example.com/a?b=1#c", "href": "https://example.com/a?b=1#c" }] },
    { "name": "http URL, any case", "text": "HTTP://Example.com/X", "links": [{ "text": "HTTP://Example.com/X", "href": "http://Example.com/X" }] },
    { "name": "bare domain", "text": "see example.com", "links": [{ "text": "example.com", "href": "https://example.com" }] },
    { "name": "bare domain with a path", "text": "example.com/x", "links": [{ "text": "example.com/x", "href": "https://example.com/x" }] },
    { "name": "www is just a bare domain", "text": "www.example.com", "links": [{ "text": "www.example.com", "href": "https://www.example.com" }] },
    { "name": "subdomains, hyphens, port and query", "text": "go to docs.my-site.co.uk:8080/a-b?q=1 today", "links": [{ "text": "docs.my-site.co.uk:8080/a-b?q=1", "href": "https://docs.my-site.co.uk:8080/a-b?q=1" }] },
    { "name": "top-level domain in capitals", "text": "Visit EXAMPLE.COM", "links": [{ "text": "EXAMPLE.COM", "href": "https://EXAMPLE.COM" }] },
    { "name": "this service's own domain", "text": "inbox.hafa.cc", "links": [{ "text": "inbox.hafa.cc", "href": "https://inbox.hafa.cc" }] },
    { "name": "several, in order", "text": "a.io and https://b.dev/x, then c.org", "links": [{ "text": "a.io", "href": "https://a.io" }, { "text": "https://b.dev/x", "href": "https://b.dev/x" }, { "text": "c.org", "href": "https://c.org" }] },
    { "name": "sentence's period left out", "text": "see example.com.", "links": [{ "text": "example.com", "href": "https://example.com" }] },
    { "name": "punctuation after a path left out", "text": "Is it https://example.com/a?! Or example.com/b, or example.com/c;", "links": [{ "text": "https://example.com/a", "href": "https://example.com/a" }, { "text": "example.com/b", "href": "https://example.com/b" }, { "text": "example.com/c", "href": "https://example.com/c" }] },
    { "name": "quoted", "text": "\"example.com/x\" and 'https://example.org'", "links": [{ "text": "example.com/x", "href": "https://example.com/x" }, { "text": "https://example.org", "href": "https://example.org" }] },
    { "name": "in parentheses", "text": "(see https://example.com/x)", "links": [{ "text": "https://example.com/x", "href": "https://example.com/x" }] },
    { "name": "balanced parentheses kept", "text": "https://en.wikipedia.org/wiki/Mercury_(planet) is", "links": [{ "text": "https://en.wikipedia.org/wiki/Mercury_(planet)", "href": "https://en.wikipedia.org/wiki/Mercury_(planet)" }] },
    { "name": "balanced parentheses kept, inside parentheses", "text": "(en.wikipedia.org/wiki/Mercury_(planet))", "links": [{ "text": "en.wikipedia.org/wiki/Mercury_(planet)", "href": "https://en.wikipedia.org/wiki/Mercury_(planet)" }] },
    { "name": "angle brackets end it", "text": "<https://example.com/x>", "links": [{ "text": "https://example.com/x", "href": "https://example.com/x" }] },
    { "name": "bold markers around it left out", "text": "*example.com* and _https://example.org/a_", "links": [{ "text": "example.com", "href": "https://example.com" }, { "text": "https://example.org/a", "href": "https://example.org/a" }] },
    { "name": "underscores inside a path kept", "text": "example.com/a_b_c", "links": [{ "text": "example.com/a_b_c", "href": "https://example.com/a_b_c" }] },
    { "name": "on its own line", "text": "Notes\nhttps://example.com\nmore", "links": [{ "text": "https://example.com", "href": "https://example.com" }] },
    { "name": "redirect wrapper unwrapped", "text": "https://www.google.com/url?q=https://example.com/a", "links": [{ "text": "https://www.google.com/url?q=https://example.com/a", "href": "https://example.com/a" }] },
    { "name": "file names aren't links", "text": "notes.txt, report.pdf, index.html, app.js, README.md, main.py, run.sh, lib.rs, data.zip", "links": [] },
