    { "name": "a domain then letters isn't one", "text": "example.comma and example.com-ish", "links": [] },
    { "name": "a domain in a non-Latin word isn't one", "text": "example.comé", "links": [] },
    { "name": "scheme alone", "text": "https:// and http://.", "links": [] },
    { "name": "empty", "text": "", "links": [] },
    { "name": "a capitalized scheme is put in lower case", "text": "Https://Example.com/A", "links": [{ "text": "Https://Example.com/A", "href": "https://Example.com/A" }] },
    { "name": "italic around a bare domain", "text": "see _example.com_.", "links": [{ "text": "example.com", "href": "https://example.com" }] },
    { "name": "bold around a bare domain", "text": "*example.com*", "links": [{ "text": "example.com", "href": "https://example.com" }] },
    { "name": "a _ that goes on into a word isn't a closing marker", "text": "example.com_foo", "links": [] },
    { "name": "a domain at the start of an email address", "text": "ana.co+news@x.com and ana.co_x@x.com", "links": [] },
    { "name": "a redirect to something other than a web address stays itself", "text": "https://www.google.com/url?q=javascript:alert(1)", "links": [{ "text": "https://www.google.com/url?q=javascript:alert(1)", "href": "https://www.google.com/url?q=javascript:alert(1)" }] }
  ],
  "safe": [
