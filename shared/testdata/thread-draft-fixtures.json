      "name": "links keep their text, images go",
      "markdown": "see [the lease](https://x.io) ![logo](cid:a1) here",
      "expect": "see the lease here"
    },
    {
      "name": "escapes dropped",
      "markdown": "1\\. not a list",
      "expect": "1. not a list"
    },
