      "name": "cut at 200",
      "markdown": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "expect": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  ],
  "opening": [
    {"name": "a row tapped in Drafts opens its draft", "inDrafts": true, "event": "tap", "openBefore": null, "openAfter": "t1", "expect": "t1"},
    {"name": "Enter on a row in Drafts opens its draft", "inDrafts": true, "event": "enter", "openBefore": null, "openAfter": "t1", "expect": "t1"},
    {"name": "another row tapped in Drafts opens its draft", "inDrafts": true, "event": "tap", "openBefore": "t1", "openAfter": "t2", "expect": "t2"},
    {"name": "a row tapped elsewhere opens its thread", "inDrafts": false, "event": "tap", "openBefore": null, "openAfter": "t1", "expect": null},
    {"name": "a thread opened from outside the list opens in Drafts too", "inDrafts": true, "event": "openThread", "openBefore": null, "openAfter": "t1", "expect": null},
    {"name": "a thread closing in Drafts opens nothing", "inDrafts": true, "event": "tap", "openBefore": "t1", "openAfter": null, "expect": null},
    {"name": "the open thread staying open opens nothing", "inDrafts": true, "event": "enter", "openBefore": "t1", "openAfter": "t1", "expect": null}
  ],
  "held": [
    {"name": "nothing held", "kept": [], "thrown": [], "sending": [], "expect": []},
    {"name": "a kept record is a draft", "kept": [{"localId": "l1", "deleted": false}], "thrown": [], "sending": [], "expect": [{"localId": "l1", "state": "draft", "kept": true}]},
    {"name": "a kept delete is deleted", "kept": [{"localId": "l1", "deleted": true}], "thrown": [], "sending": [], "expect": [{"localId": "l1", "state": "deleted", "kept": true}]},
    {"name": "a record thrown away in its undo window is deleted, not a draft", "kept": [{"localId": "l1", "deleted": false}], "thrown": ["l1"], "sending": [], "expect": [{"localId": "l1", "state": "deleted", "kept": true}]},
    {"name": "a kept record being sent is sending", "kept": [{"localId": "l1", "deleted": false}], "thrown": [], "sending": ["l1"], "expect": [{"localId": "l1", "state": "sending", "kept": true}]},
    {"name": "thrown away wins over sending", "kept": [{"localId": "l1", "deleted": false}], "thrown": ["l1"], "sending": ["l1"], "expect": [{"localId": "l1", "state": "deleted", "kept": true}]},
    {"name": "a send whose record went stays sending", "kept": [], "thrown": [], "sending": ["l1"], "expect": [{"localId": "l1", "state": "sending", "kept": false}]},
    {"name": "a discard with no record is deleted", "kept": [], "thrown": ["l1"], "sending": [], "expect": [{"localId": "l1", "state": "deleted", "kept": false}]},
    {"name": "a draft with no record is never a draft", "kept": [{"localId": "l2", "deleted": false}], "thrown": ["l3"], "sending": ["l1", "l3"], "expect": [{"localId": "l2", "state": "draft", "kept": true}, {"localId": "l3", "state": "deleted", "kept": false}, {"localId": "l1", "state": "sending", "kept": false}]},
    {"name": "kept records keep their order, each once", "kept": [{"localId": "l2", "deleted": false}, {"localId": "l1", "deleted": false}, {"localId": "l2", "deleted": false}], "thrown": [], "sending": [], "expect": [{"localId": "l2", "state": "draft", "kept": true}, {"localId": "l1", "state": "draft", "kept": true}]}
  ]
}
