      "name": "styles left out",
      "markdown": "Hi **Sam**, _really_ ~~not~~ `now`",
      "expect": "Hi Sam, really not now"
    },
    {
      "name": "lines joined",
      "markdown": "Hi,\n\n> quoted\n# Heading\nbye",
      "expect": "Hi, quoted Heading bye"
    },
