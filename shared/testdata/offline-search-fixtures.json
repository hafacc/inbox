{
  "_doc": "Searching saved mail while offline (shared/src/offline-search.ts, Android :core search/SearchPlan.kt). `terms`: freeTerms(free). `match`: matchesOffline(thread, chips, freeTerms(free)) for parseQuery(query, null) of each query, with `labels` (default: Label_1 \"Home Stuff\", Label_2 \"Work/Projects\"); `saved` is null for a thread not opened on the device, and its texts are already lower-cased. `expect` lists the queries the thread matches; `reject` those it doesn't. `-in:inbox` is left to the list's filter, which keeps a snoozed thread still in Gmail's inbox.",
  "terms": [
    { "name": "plain words", "free": "lease garage", "expect": { "include": ["lease", "garage"], "exclude": [] } },
    { "name": "phrases, exclusions, OR and brackets", "free": "lease \"garage remote\" -spam OR (x)", "expect": { "include": ["lease", "garage remote", "x"], "exclude": ["spam"] } },
    { "name": "AND is dropped, any case", "free": "lease AND garage and Or", "expect": { "include": ["lease", "garage"], "exclude": [] } },
    { "name": "an excluded phrase", "free": "-\"weekly digest\" news", "expect": { "include": ["news"], "exclude": ["weekly digest"] } },
    { "name": "words lower-cased", "free": "Maya CHEN", "expect": { "include": ["maya", "chen"], "exclude": [] } },
    { "name": "spaces inside a phrase made one", "free": "\"  garage   remote \"", "expect": { "include": ["garage remote"], "exclude": [] } },
    { "name": "an empty phrase and braces left out", "free": "\"\" {a b}", "expect": { "include": ["a", "b"], "exclude": [] } },
    { "name": "nothing", "free": "   ", "expect": { "include": [], "exclude": [] } }
  ],
  "match": [
    {
      "name": "a thread only listed: words in its row, chips on its labels",
      "thread": {
        "subject": "Garage lease",
        "snippet": "The remote is in the drawer",
        "senders": [{ "name": "Maya Chen", "email": "maya@example.com" }],
        "labelIds": ["INBOX", "UNREAD", "Label_1", "STARRED"],
        "unread": true,
        "saved": null
      },
      "expect": [
        "lease", "LEASE", "garage remote", "remote drawer", "maya", "example.com", "lease -dinner",
        "from:maya", "from:example", "from:chen", "subject:garage", "is:unread", "is:starred", "is:pinned",
        "in:inbox", "in:starred", "in:anywhere", "label:home-stuff", "-label:work-projects", "-is:read", "-is:done",
        "to:anyone", "-to:anyone", "has:attachment", "-has:attachment", "after:2026/01/01 lease", "is:snoozed lease",
        "in:outbox", "category:social", "is:muted", "in:chats", "-in:inbox"
      ],
      "reject": [
        "dinner", "lease -remote", "foo -garage", "\"lease garage\"", "\"remote drawer\"", "from:sam", "-from:maya",
        "subject:remote", "is:read", "is:done", "is:important", "in:sent", "in:trash",
        "label:work-projects", "label:nothing", "-label:home-stuff", "foo bar"
      ]
    },
    {
      "name": "an opened thread: words in its messages, recipients and attachments",
      "thread": {
        "subject": "Dinner",
        "snippet": "See you at eight",
        "senders": [{ "name": "Sam", "email": "sam@x.example.com" }],
        "labelIds": ["SENT", "IMPORTANT", "Label_2"],
        "unread": false,
        "saved": {
          "recipients": "jose rivera jose@rivera.example.net ana ana@x.example.com",
          "text": "dinner\nsam sam@x.example.com\njose rivera jose@rivera.example.net\nbring the garage opener tonight",
          "attachment": true
        }
      },
      "expect": [
        "dinner", "garage opener", "jose", "rivera.example.net", "bring -lunch", "to:jose", "cc:ana", "bcc:rivera",
        "deliveredto:ana@x.example.com", "has:attachment", "is:read", "is:done", "is:important", "in:sent",
        "label:work-projects", "-to:maya", "-is:unread"
      ],
      "reject": [
        "lease", "dinner -opener", "-jose", "to:maya", "-to:jose", "-has:attachment", "is:unread", "in:inbox",
        "label:home-stuff", "\"eight bring\""
      ]
    },
    {
      "name": "an opened thread with no attachment",
      "thread": {
        "subject": "Notes",
        "snippet": "",
        "senders": [],
        "labelIds": [],
        "unread": false,
        "saved": { "recipients": "", "text": "notes", "attachment": false }
      },
      "expect": ["notes", "-has:attachment", "is:done", "has:drive"],
      "reject": ["has:attachment", "to:anyone", "from:anyone"]
    }
  ]
}
