      },
      "toGmail": { "addLabelIds": ["Label_12", "STARRED", "IMPORTANT"], "removeLabelIds": ["INBOX", "UNREAD"] },
      "existing": { "add": ["Label_12", "STARRED", "IMPORTANT"], "remove": ["INBOX", "UNREAD"] }
