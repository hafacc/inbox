        "status": "woken",
        "snoozeUntil": 5000
      }
    },
    {
      "name": "a reply Gmail split off after the snooze wakes the row",
      "members": [
        {
          "status": "snoozed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "10",
          "inInbox": true
        },
        {
          "status": "snoozed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "9",
          "inInbox": true
        },
        {
          "status": "none",
          "snoozeUntil": null,
          "watermark": null,
          "historyId": "15",
          "inInbox": true
        }
      ],
      "expect": {
        "status": "woken",
        "snoozeUntil": 5000
      }
    },
    {
      "name": "a split-off reply a filter kept out of the inbox doesn't",
      "members": [
        {
          "status": "snoozed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "10",
          "inInbox": true
