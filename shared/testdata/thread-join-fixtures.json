            },
            {
              "name": "",
              "email": "bob@x"
            }
          ],
          "messageCount": 2,
          "lastDate": 1000,
          "sentDate": 900,
          "labelIds": [
            "INBOX",
            "Label_1"
          ],
          "unread": false
        },
        {
          "id": "B",
          "historyId": "1200",
          "subject": "...",
          "snippet": "new",
          "senders": [
            {
              "name": "Bob",
              "email": "bob@x"
            },
            {
              "name": "Cy",
              "email": "cy@x"
            }
          ],
          "messageCount": 1,
          "lastDate": 2000,
          "sentDate": 0,
          "labelIds": [
            "INBOX",
            "UNREAD"
          ],
          "unread": true
        }
      ],
      "expect": {
        "id": "A",
        "historyId": "1200",
        "subject": "...",
        "snippet": "new",
        "senders": [
          {
            "name": "Ana",
            "email": "ana@x"
          },
          {
            "name": "Bob",
            "email": "bob@x"
          },
          {
            "name": "Cy",
