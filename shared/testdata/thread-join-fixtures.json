        {
          "status": "none",
          "snoozeUntil": null,
          "watermark": null,
          "historyId": "15",
          "inInbox": false
        }
      ],
      "expect": {
        "status": "snoozed",
        "snoozeUntil": 5000
      }
    },
    {
      "name": "a member older than the snooze with none of its own doesn't",
      "members": [
        {
          "status": "snoozed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "10",
          "inInbox": true
