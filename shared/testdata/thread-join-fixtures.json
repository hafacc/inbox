{
  "_doc": {
    "joins": "joinThreads(threads): groups of thread ids shown as one row, each oldest first by firstDate (list order breaks ties), groups ordered by their lead's list position; singletons omitted. A thread with hiddenSubject joins the loaded thread holding any id in its answers; joins chain.",
    "summaries": "joinSummaries(members), lead first: lead's fields, with historyId the largest (as integers), snippet of the member with the latest lastDate, senders in member order once each by email (an empty name filled by a later one), messageCount summed, lastDate and sentDate the largest, labelIds the sorted union, unread if any.",
    "snooze": "joinedSnooze(members): none if every member is none; woken if any member is woken, or a none member in the inbox has a historyId above some snoozed member's watermark; else snoozed if any member is snoozed; else lapsed. snoozeUntil is the latest of the snoozed members'.",
    "answered": "answeredSearch(answers): a summary's answers (with angle brackets), the first 20 as rfc822msgid: terms without the brackets, joined with \" OR \"; null when there are none."
  },
