          "status": "lapsed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "10",
          "inInbox": true
        },
        {
          "status": "lapsed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "9",
          "inInbox": true
        }
      ],
      "expect": {
        "status": "lapsed",
        "snoozeUntil": 5000
      }
    },
    {
      "name": "snoozed while any member still is",
      "members": [
        {
          "status": "lapsed",
          "snoozeUntil": 4000,
          "watermark": "10",
          "historyId": "10",
          "inInbox": true
        },
        {
          "status": "snoozed",
          "snoozeUntil": 5000,
          "watermark": "10",
          "historyId": "9",
          "inInbox": true
        }
      ],
      "expect": {
        "status": "snoozed",
        "snoozeUntil": 5000
      }
    }
