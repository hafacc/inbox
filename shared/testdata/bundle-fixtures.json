{
  "_doc": {
    "about": "Inbox bundles' own Gmail lists, run by shared/src/bundles.spec.ts and Android :core (BundlesFixturesTest).",
    "unpinAll": "bundleUnpinsAll(shown, todosPinned, more): whether Pin all is Unpin all: at least one thread or todo, every shown thread ({id, pinned}) and todo (each its pinned) pinned, and Gmail has no more (more).",
    "sweep": "bundleSweepIds(shown, listed, pinned): what Done all or a swipe on a bundle acts on: shown ({id, pinned}, its loaded threads) but pinned ones, then listed (the label's inbox ids Gmail listed, when it has more) but those in pinned, each once.",
    "ids": "inboxThreadIds(inboxIds, bundles, labels): the inbox's own ids, then each bundle list's ids that still carry its label, each once.",
    "fetch": "bundlesToFetch(bundleLabels, inboxLabels, fetched, remembered): bundle labels not fetched yet that a thread of the inbox's own list carries or that are remembered from last session, in bundleLabels order.",
    "remember": "bundlesToRemember(bundles): the labels of bundle lists holding at least one thread, in order.",
    "exclusion": "inboxExclusion(labels, known): the query leaving fetched bundles' threads out of the inbox's own list: -category:x for a category (personal is primary), -label:name otherwise (lower-case, spaces and / as -), space-separated; \"\" when none. A label is skipped when its name holds anything but letters, digits, spaces, / and -, or when another of known (default: labels) has the same query name.",
    "merge": "mergeFirstPage(existing, page): a refreshed first page, then the loaded ids past the old place of the page's last known id; null when the page shares nothing with existing.",
    "nextPage": "inboxNextPage(query, pageToken, tokenQuery): the next inbox page's query and token; the token only while the query is the one it came from, else paging starts over.",
    "counts": "bundleCounts(threads, unread, more, todos ?? 0): \"N\" / \"N+\" threads and todos together and \"N new\" / \"N+ new\" unread (null when none); \"+\" when Gmail has a next page.",
    "line": "bundleLine(texts): a closed bundle row's line after its senders: texts (its emails' subjects and its todos' plain texts, in the bundle's order) trimmed, blank and repeated ones (exactly the same text) left out, the first 3 joined by \" · \".",
    "touched": "touchedBundles(records, bundleLabels): bundle labels on a message added, deleted or relabeled, or themselves added or removed, in bundleLabels order.",
    "inbox": "inInbox(labels): true when labels hold INBOX and neither SPAM nor TRASH.",
    "topUp": "bundlesToTopUp(bundles): labels, in order, with more in Gmail, no page loading and no failed page, and either no thread shown, or open with fewer than 10 shown, its end on screen, or fewer than 3 loaded threads after the thread open in it (afterOpen; null: none of its threads open)."
  },
  "ids": [
    {
      "name": "bundle threads past the loaded inbox join it",
      "inboxIds": ["a", "l1"],
      "bundles": [{ "labelId": "L", "ids": ["l1", "l2", "l3"], "more": false }],
      "labels": { "a": ["INBOX"], "l1": ["INBOX", "L"], "l2": ["INBOX", "L"], "l3": ["INBOX", "L"] },
      "expect": ["a", "l1", "l2", "l3"]
    },
    {
      "name": "a thread that lost the label since the fetch leaves",
      "inboxIds": ["a"],
      "bundles": [{ "labelId": "L", "ids": ["l1", "l2"], "more": true }],
      "labels": { "a": ["INBOX"], "l1": ["INBOX", "L"], "l2": ["INBOX"] },
      "expect": ["a", "l1"]
    },
    {
      "name": "a thread not yet summarized waits",
      "inboxIds": [],
      "bundles": [{ "labelId": "L", "ids": ["l1", "l2"], "more": false }],
      "labels": { "l1": ["INBOX", "L"] },
      "expect": ["l1"]
    },
    {
      "name": "a thread in two bundles shows once",
      "inboxIds": ["a"],
      "bundles": [
        { "labelId": "L", "ids": ["x"], "more": false },
        { "labelId": "M", "ids": ["x", "m1"], "more": false }
      ],
      "labels": { "a": ["INBOX"], "x": ["INBOX", "L", "M"], "m1": ["INBOX", "M"] },
      "expect": ["a", "x", "m1"]
    },
    {
      "name": "a pinned thread past its bundle's fetched ones joins from the pinned list",
      "inboxIds": ["a"],
      "bundles": [
        { "labelId": "L", "ids": ["l1"], "more": true },
        { "labelId": "STARRED", "ids": ["p1", "l9"], "more": false }
      ],
      "labels": { "a": ["INBOX"], "l1": ["INBOX", "L"], "p1": ["INBOX", "STARRED"], "l9": ["INBOX", "L", "STARRED"] },
      "expect": ["a", "l1", "p1", "l9"]
    },
    {
      "name": "a thread unpinned since the pinned list was fetched leaves it",
      "inboxIds": [],
      "bundles": [{ "labelId": "STARRED", "ids": ["p1", "p2"], "more": false }],
      "labels": { "p1": ["INBOX", "STARRED"], "p2": ["INBOX", "L"] },
      "expect": ["p1"]
    }
  ],
  "fetch": [
    {
      "name": "only labels on loaded inbox threads",
      "bundleLabels": ["L", "M", "N"],
      "inboxLabels": [["INBOX", "M"], ["INBOX"], ["INBOX", "L", "X"]],
      "fetched": [],
      "remembered": [],
      "expect": ["L", "M"]
    },
    {
      "name": "a label fetched already is left to history",
      "bundleLabels": ["L", "M"],
      "inboxLabels": [["INBOX", "L"], ["INBOX", "M"]],
      "fetched": ["L"],
      "remembered": [],
      "expect": ["M"]
    },
    {
      "name": "a label with bundling off is never fetched",
      "bundleLabels": [],
      "inboxLabels": [["INBOX", "L"]],
      "fetched": [],
      "remembered": ["L"],
      "expect": []
    },
    {
      "name": "a remembered label is fetched before any inbox thread shows it",
      "bundleLabels": ["L", "M", "N"],
      "inboxLabels": [],
      "fetched": [],
      "remembered": ["N", "L"],
      "expect": ["L", "N"]
    },
    {
      "name": "a remembered label fetched already isn't fetched again",
      "bundleLabels": ["L", "M"],
      "inboxLabels": [["INBOX", "M"]],
      "fetched": ["L"],
      "remembered": ["L"],
      "expect": ["M"]
    }
  ],
  "remember": [
    {
      "name": "lists that found threads",
      "bundles": [
        { "labelId": "L", "ids": ["l1"], "more": false },
        { "labelId": "M", "ids": [], "more": false },
        { "labelId": "N", "ids": ["n1", "n2"], "more": true }
      ],
      "expect": ["L", "N"]
    },
    { "name": "none", "bundles": [], "expect": [] }
  ],
  "counts": [
    { "name": "all fetched", "threads": 12, "unread": 3, "more": false, "expect": { "threads": "12", "unread": "3 new" } },
    { "name": "more in Gmail", "threads": 50, "unread": 50, "more": true, "expect": { "threads": "50+", "unread": "50+ new" } },
    { "name": "some unread, more in Gmail", "threads": 50, "unread": 7, "more": true, "expect": { "threads": "50+", "unread": "7+ new" } },
    { "name": "none unread", "threads": 50, "unread": 0, "more": true, "expect": { "threads": "50+", "unread": null } },
    { "name": "todos add to the threads, more in Gmail", "threads": 10, "todos": 2, "unread": 1, "more": true, "expect": { "threads": "12+", "unread": "1+ new" } },
    { "name": "todos alone", "threads": 0, "todos": 3, "unread": 0, "more": false, "expect": { "threads": "3", "unread": null } }
  ],
  "line": [
    { "name": "the first three, in order", "texts": ["Invoice", "Buy milk", "Receipt", "Order shipped"], "expect": "Invoice · Buy milk · Receipt" },
    { "name": "a repeated subject shows once, and the next one takes its place", "texts": ["Build failed", "Build failed", "Call Ana", "Build failed", "Deploy done"], "expect": "Build failed · Call Ana · Deploy done" },
    { "name": "blank ones are left out, and each is trimmed", "texts": ["", "  Lunch  ", " ", "Lunch", "Pay rent"], "expect": "Lunch · Pay rent" },
    { "name": "a repeat differing in case is kept", "texts": ["Hello", "hello"], "expect": "Hello · hello" },
    { "name": "nothing to name", "texts": ["", " "], "expect": "" }
  ],
  "touched": [
    {
      "name": "new mail carrying a bundle label",
      "bundleLabels": ["L", "M"],
      "records": [{ "id": "1", "messagesAdded": [{ "message": { "id": "m", "labelIds": ["INBOX", "M", "UNREAD"] } }] }],
      "expect": ["M"]
    },
    {
      "name": "archiving a bundled message",
      "bundleLabels": ["L", "M"],
      "records": [{ "id": "1", "labelsRemoved": [{ "message": { "id": "m", "labelIds": ["L"] }, "labelIds": ["INBOX"] }] }],
      "expect": ["L"]
    },
    {
      "name": "the label itself added or removed",
      "bundleLabels": ["L", "M"],
      "records": [
        { "id": "1", "labelsAdded": [{ "message": { "id": "m", "labelIds": ["INBOX", "M"] }, "labelIds": ["M"] }] },
        { "id": "1", "labelsRemoved": [{ "message": { "id": "m", "labelIds": ["INBOX"] }, "labelIds": ["L"] }] }
      ],
      "expect": ["L", "M"]
    },
    {
      "name": "a deleted message",
      "bundleLabels": ["L"],
      "records": [{ "id": "1", "messagesDeleted": [{ "message": { "id": "m", "labelIds": ["L", "TRASH"] } }] }],
      "expect": ["L"]
    },
    {
      "name": "mail without a bundle label touches none",
      "bundleLabels": ["L"],
      "records": [{ "id": "1", "messagesAdded": [{ "message": { "id": "m", "labelIds": ["INBOX"] } }] }, { "id": "1", "labelsAdded": [{ "message": { "id": "m" }, "labelIds": ["STARRED"] }] }],
      "expect": []
    }
  ],
  "exclusion": [
    { "name": "none", "labels": [], "expect": "" },
    { "name": "user labels by query name", "labels": [{ "id": "Label_1", "name": "GitHub" }, { "id": "Label_2", "name": "Work/Travel Plans" }], "expect": "-label:github -label:work-travel-plans" },
    { "name": "categories by category", "labels": [{ "id": "CATEGORY_PROMOTIONS", "name": "Promotions" }, { "id": "CATEGORY_PERSONAL", "name": "Primary" }], "expect": "-category:promotions -category:primary" },
    { "name": "names Gmail's query may read otherwise are kept in", "labels": [{ "id": "Label_1", "name": "Work (old)" }, { "id": "Label_2", "name": "Say \"hi\"" }, { "id": "Label_3", "name": "{x}" }, { "id": "Label_4", "name": "R&D" }, { "id": "Label_5", "name": "Café-Bar 2" }], "expect": "-label:café-bar-2" },
    { "name": "a query name shared with another label is kept in", "labels": [{ "id": "Label_1", "name": "Work/Projects" }, { "id": "Label_3", "name": "News" }], "known": [{ "id": "Label_1", "name": "Work/Projects" }, { "id": "Label_2", "name": "Work Projects" }, { "id": "Label_3", "name": "News" }], "expect": "-label:news" },
    { "name": "a user label named like a category is kept in", "labels": [{ "id": "Label_1", "name": "Promotions" }, { "id": "CATEGORY_PROMOTIONS", "name": "Promotions" }], "expect": "-category:promotions" }
  ],
  "merge": [
    { "name": "keeps the loaded pages past it", "existing": ["a", "b", "c", "d", "e"], "page": ["n", "a", "c"], "expect": ["n", "a", "c", "d", "e"] },
    { "name": "drops threads gone from its stretch", "existing": ["a", "b", "c"], "page": ["a", "c"], "expect": ["a", "c"] },
    { "name": "no overlap starts the list over", "existing": ["a", "b"], "page": ["x", "y"], "expect": null },
    { "name": "a thread that rose to the top leaves its old place", "existing": ["a", "b", "c", "d", "e"], "page": ["d", "a", "b"], "expect": ["d", "a", "b", "c", "e"] }
  ],
  "nextPage": [
    { "name": "same query keeps paging", "query": "-label:github", "pageToken": "t2", "tokenQuery": "-label:github", "expect": { "q": "-label:github", "pageToken": "t2" } },
    { "name": "a bundle left out since starts over", "query": "-label:github -category:promotions", "pageToken": "t2", "tokenQuery": "-label:github", "expect": { "q": "-label:github -category:promotions", "pageToken": null } },
    { "name": "the first bundle left out starts over", "query": "-label:github", "pageToken": "t2", "tokenQuery": "", "expect": { "q": "-label:github", "pageToken": null } }
  ],
  "inbox": [
    { "name": "inbox", "labels": ["INBOX", "UNREAD"], "expect": true },
    { "name": "archived", "labels": ["Label_1"], "expect": false },
    { "name": "spam", "labels": ["SPAM"], "expect": false },
    { "name": "inbox and spam together", "labels": ["INBOX", "SPAM"], "expect": false },
    { "name": "inbox and trash together", "labels": ["INBOX", "TRASH", "Label_1"], "expect": false }
  ],
  "topUp": [
    { "name": "closed with threads left", "bundles": [{ "labelId": "A", "shown": 3, "more": true, "loading": false, "failed": false, "open": false, "endShown": false, "afterOpen": null }], "expect": [] },
    { "name": "closed and emptied", "bundles": [{ "labelId": "A", "shown": 0, "more": true, "loading": false, "failed": false, "open": false, "endShown": false, "afterOpen": null }], "expect": ["A"] },
    { "name": "open and short", "bundles": [{ "labelId": "A", "shown": 4, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": null }], "expect": ["A"] },
    { "name": "open with a full page", "bundles": [{ "labelId": "A", "shown": 10, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": null }], "expect": [] },
    { "name": "open with its end on screen", "bundles": [{ "labelId": "A", "shown": 30, "more": true, "loading": false, "failed": false, "open": true, "endShown": true, "afterOpen": null }], "expect": ["A"] },
    { "name": "nothing more in Gmail", "bundles": [{ "labelId": "A", "shown": 0, "more": false, "loading": false, "failed": false, "open": false, "endShown": false, "afterOpen": null }, { "labelId": "B", "shown": 2, "more": false, "loading": false, "failed": false, "open": true, "endShown": true, "afterOpen": null }], "expect": [] },
    { "name": "a page already on its way", "bundles": [{ "labelId": "A", "shown": 0, "more": true, "loading": true, "failed": false, "open": false, "endShown": false, "afterOpen": null }], "expect": [] },
    { "name": "the last page failed", "bundles": [{ "labelId": "A", "shown": 2, "more": true, "loading": false, "failed": true, "open": true, "endShown": false, "afterOpen": null }], "expect": [] },
    { "name": "several, in order", "bundles": [{ "labelId": "A", "shown": 0, "more": true, "loading": false, "failed": false, "open": false, "endShown": false, "afterOpen": null }, { "labelId": "B", "shown": 12, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": null }, { "labelId": "C", "shown": 1, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": null }], "expect": ["A", "C"] },
    { "name": "a thread open near its end, so swiping on reaches past it", "bundles": [{ "labelId": "A", "shown": 30, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": 2 }, { "labelId": "B", "shown": 30, "more": true, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": 3 }, { "labelId": "C", "shown": 30, "more": false, "loading": false, "failed": false, "open": true, "endShown": false, "afterOpen": 0 }, { "labelId": "D", "shown": 30, "more": true, "loading": true, "failed": false, "open": true, "endShown": false, "afterOpen": 0 }], "expect": ["A"] }
  ],
  "sweep": [
    { "name": "all loaded", "shown": [{ "id": "a", "pinned": false }, { "id": "b", "pinned": false }], "listed": [], "pinned": [], "expect": ["a", "b"] },
    { "name": "a pinned one stays", "shown": [{ "id": "a", "pinned": true }, { "id": "b", "pinned": false }], "listed": [], "pinned": [], "expect": ["b"] },
    { "name": "Gmail has more", "shown": [{ "id": "a", "pinned": false }, { "id": "b", "pinned": false }], "listed": ["a", "b", "c", "d", "e"], "pinned": ["d"], "expect": ["a", "b", "c", "e"] },
    { "name": "the listing failed", "shown": [{ "id": "a", "pinned": false }], "listed": [], "pinned": [], "expect": ["a"] }
  ],
  "unpinAll": [
    { "name": "an unpinned thread: Pin all", "shown": [{ "id": "a", "pinned": true }, { "id": "b", "pinned": false }], "todosPinned": [], "more": false, "expect": false },
    { "name": "every thread pinned: Unpin all", "shown": [{ "id": "a", "pinned": true }, { "id": "b", "pinned": true }], "todosPinned": [], "more": false, "expect": true },
    { "name": "every thread and todo pinned: Unpin all", "shown": [{ "id": "a", "pinned": true }], "todosPinned": [true, true], "more": false, "expect": true },
    { "name": "an unpinned todo: Pin all", "shown": [{ "id": "a", "pinned": true }], "todosPinned": [true, false], "more": false, "expect": false },
    { "name": "only pinned todos: Unpin all", "shown": [], "todosPinned": [true], "more": false, "expect": true },
    { "name": "Gmail has more: Pin all", "shown": [{ "id": "a", "pinned": true }], "todosPinned": [], "more": true, "expect": false },
    { "name": "empty: Pin all", "shown": [], "todosPinned": [], "more": false, "expect": false }
  ]
}
