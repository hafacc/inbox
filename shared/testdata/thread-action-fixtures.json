{
  "_doc": "The actions an open thread offers, in order (threadActions in shared/src/view-filter.ts, Android :core ThreadActions.kt), and where a phone shows them (threadActionPlaces). `thread` {labelIds, snoozed (snoozed now), unread, todo (\"add\", \"edit\" or null while todos are off), hasSender}; `expect` the actions; `places` {inner, outer (the corner button's two rings, each from the top; no Mark read or unread), marker, line}. Done or Move to inbox follows inboxAction (view-filter-fixtures.json). `rows`: rowHoldActions(actions), what an email row's round menu offers, in its order.",
  "cases": [
    {
      "name": "inbox thread",
      "thread": { "labelIds": ["INBOX"], "snoozed": false, "unread": false, "todo": "add", "hasSender": true },
      "expect": ["done", "snooze", "pin", "label", "addTodo", "important", "unread", "spam", "delete", "filter"],
      "places": { "inner": ["done", "snooze", "pin"], "outer": ["label", "addTodo", "spam", "delete"], "marker": "important", "line": ["filter"] }
    },
    {
      "name": "done thread moves to the inbox",
      "thread": { "labelIds": [], "snoozed": false, "unread": false, "todo": "add", "hasSender": true },
      "expect": ["inbox", "snooze", "pin", "label", "addTodo", "important", "unread", "spam", "delete", "filter"],
      "places": { "inner": ["inbox", "snooze", "pin"], "outer": ["label", "addTodo", "spam", "delete"], "marker": "important", "line": ["filter"] }
    },
    {
      "name": "done thread in a label moves to the inbox",
      "thread": { "labelIds": ["Label_1"], "snoozed": false, "unread": true, "todo": null, "hasSender": true },
      "expect": ["inbox", "snooze", "pin", "label", "important", "read", "spam", "delete", "filter"],
      "places": { "inner": ["inbox", "snooze", "pin"], "outer": ["label", "spam", "delete"], "marker": "important", "line": ["filter"] }
    },
    {
      "name": "snoozed thread is done and wakes",
      "thread": { "labelIds": ["INBOX"], "snoozed": true, "unread": false, "todo": "edit", "hasSender": true },
      "expect": ["done", "snooze", "wake", "pin", "label", "editTodo", "important", "unread", "spam", "delete", "filter"],
      "places": { "inner": ["done", "snooze", "pin"], "outer": ["label", "editTodo", "spam", "delete"], "marker": "important", "line": ["wake", "filter"] }
    },
    {
      "name": "pinned important unread thread",
      "thread": { "labelIds": ["INBOX", "STARRED", "IMPORTANT", "UNREAD"], "snoozed": false, "unread": true, "todo": null, "hasSender": true },
      "expect": ["done", "snooze", "unpin", "label", "unimportant", "read", "spam", "delete", "filter"],
      "places": { "inner": ["done", "snooze", "unpin"], "outer": ["label", "spam", "delete"], "marker": "unimportant", "line": ["filter"] }
    },
    {
      "name": "spam thread has Not spam and no inbox action",
      "thread": { "labelIds": ["SPAM"], "snoozed": false, "unread": false, "todo": null, "hasSender": true },
      "expect": ["snooze", "pin", "label", "important", "unread", "notSpam", "delete", "filter"],
      "places": { "inner": ["snooze", "pin"], "outer": ["label", "notSpam", "delete"], "marker": "important", "line": ["filter"] }
    },
    {
      "name": "trash thread moves back to the inbox and has no inbox action",
      "thread": { "labelIds": ["TRASH"], "snoozed": false, "unread": false, "todo": null, "hasSender": true },
      "expect": ["snooze", "pin", "label", "important", "unread", "spam", "untrash", "filter"],
      "places": { "inner": ["snooze", "pin"], "outer": ["label", "spam", "untrash"], "marker": "important", "line": ["filter"] }
    },
    {
      "name": "no sender loaded yet: no filter",
      "thread": { "labelIds": ["INBOX"], "snoozed": false, "unread": false, "todo": null, "hasSender": false },
      "expect": ["done", "snooze", "pin", "label", "important", "unread", "spam", "delete"],
      "places": { "inner": ["done", "snooze", "pin"], "outer": ["label", "spam", "delete"], "marker": "important", "line": [] }
    }
  ],
  "rows": [
    {
      "name": "inbox email: Pin and Delete",
      "actions": ["done", "snooze", "pin", "label", "addTodo", "important", "unread", "spam", "delete", "filter"],
      "expect": ["pin", "delete"]
    },
    {
      "name": "pinned snoozed email: Unpin and Delete, no Done, Snooze or Wake now",
      "actions": ["done", "snooze", "wake", "unpin", "label", "editTodo", "important", "read", "spam", "delete", "filter"],
      "expect": ["unpin", "delete"]
    },
    {
      "name": "trash email: Pin and Move to inbox",
      "actions": ["snooze", "pin", "label", "important", "unread", "spam", "untrash", "filter"],
      "expect": ["pin", "untrash"]
    }
  ]
}
