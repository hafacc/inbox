  "format": [
    {
      "chip": {
        "operator": "from",
        "value": "maya@example.com",
        "negated": false
      },
      "expect": "from:maya@example.com"
    },
    {
      "chip": {
        "operator": "from",
        "value": "Maya Chen",
        "negated": false
      },
      "expect": "from:\"Maya Chen\""
    },
    {
      "chip": {
        "operator": "subject",
        "value": "say \"hi\" now",
        "negated": true
      },
      "expect": "-subject:\"say hi now\""
    },
    {
      "chip": {
        "operator": "filename",
        "value": "report(1).pdf",
        "negated": false
      },
      "expect": "filename:\"report(1).pdf\""
    },
    {
      "chip": {
        "operator": "#",
        "value": "work/projects",
        "negated": true
      },
      "expect": "-#work/projects"
    }
  ],
  "query": [
    {
      "chips": [
        {
          "operator": "from",
          "value": "maya",
          "negated": false
        },
        {
